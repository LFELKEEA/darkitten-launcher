      "version": "1.2.0",
      "author": "LFELKEEA",
      "description": "通过 SnowLuma 把 QQ 私聊和群聊接进桌宠：可视化设置面板、人格卡、长期记忆、黑话库、白名单、习惯化回复、表情、QQ 空间，以及 SnowLuma 自动启停。",
      "api_version": 1,
      "permissions": [
        "pet.say",
        "ai.chat",
        "timer",
        "settings"
      ],
      "permission_labels": [
        "说话",
        "AI 对话",
        "定时器",
        "设置"
      ],
      "requires": [
        {
          "name": "SnowLuma",
          "version": ">=2.2.1",
          "url": "https://github.com/SnowLuma/SnowLuma/releases",
          "note": "本地运行并扫码登录 QQ；插件通过 OneBot 11 HTTP 连接。"
        },
        {
          "name": "桌宠 LFELKEEA",
          "version": ">=1.1.1",
          "url": "https://github.com/LFELKEEA/darkitten-launcher/releases",
          "note": "1.1.1 起支持插件自带设置面板；旧版本没有“设置”按钮。"
        }
      ],
      "highlights": [
        {
          "label": "配置方式",
          "value": "可视化面板"
        },
        {
          "label": "连接方式",
          "value": "OneBot 11 HTTP"
        },
        {
          "label": "人格与记忆",
          "value": "本地保存"
        },
        {
          "label": "外发范围",
          "value": "白名单"
        },
        {
          "label": "进程管理",
          "value": "随插件自动启停"
        }
      ],
      "settings": {
