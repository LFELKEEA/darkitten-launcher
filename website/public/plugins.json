        },
        {
          "label": "流程",
          "value": "不限步数，做到完成"
        },
        {
          "label": "产物",
          "value": "直接生成可启用插件"
        },
        {
          "label": "安全",
          "value": "目录沙箱 + 改动前备份"
        },
        {
          "label": "审批",
          "value": "命令与启用插件需确认"
        },
        {
          "label": "还原",
          "value": "一键退回初始状态"
        },
        {
