    {
      "id": "lfelkeea.qq_bridge",
      "name": "QQ 桥接（SnowLuma）",
      "version": "1.7.0",
      "author": "LFELKEEA",
      "description": "通过 SnowLuma 把 QQ 私聊和群聊接进桌宠：可视化设置面板、人格卡、长期记忆、黑话库、可加备注的白名单、盯人即时回复、习惯化回复、收藏表情、QQ 空间与评论自动回复、SnowLuma 自动启停、聊天图片识别，以及 Windows 本地语音 / GPT-SoVITS 自定义音色的 TTS 语音回复。1.6.0 起 GPT-SoVITS 也能自动探测安装目录、后台无窗口启动，并在设置面板里切换参考音色。1.7.0 起可以接入「活人感内核」：回复会带上她当前的状态、最近的自我认识和按话题召回的记忆，聊天也会写回内核，成为下一次重逢的素材；没安装内核时完全按原来的逻辑工作。",
      "api_version": 1,
      "permissions": [
        "pet.say",
        "ai.chat",
        "timer",
        "settings"
      ],
      "permission_labels": [
        "说话",
        "AI 对话",
        "定时器",
        "设置"
      ],
      "requires": [
        {
          "name": "SnowLuma",
          "version": ">=2.2.1",
          "url": "https://github.com/SnowLuma/SnowLuma/releases",
          "note": "本地运行并扫码登录 QQ；插件通过 OneBot 11 HTTP 连接。"
        },
        {
          "name": "桌宠 LFELKEEA",
          "version": ">=1.1.1",
          "url": "https://github.com/LFELKEEA/darkitten-launcher/releases",
          "note": "1.1.1 起支持插件自带设置面板；旧版本没有“设置”按钮。"
        }
      ],
      "highlights": [
